{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carterflayhart",
  "pages_build_output_dir": "_site",
  "compatibility_date": "2026-11-01",
  "vars": {
    "GITHUB_OWNER_ID": "168453384",
    "SITE_ORIGIN": "https://carterflayhart.pages.dev"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "carter-site-activity",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
